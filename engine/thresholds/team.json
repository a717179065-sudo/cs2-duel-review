  "t01_mine_share": 0.15,
  "_t01_list": "TEAM-01 功劳是队友：主要原因写出每人前 list_max 个击杀（第几秒、在哪、打死谁），写出来的队友不超过 list_mates 人；你的份额 >= mine_share 时再写上你自己的击杀",
  "mate_also_ratio": 0.75,
